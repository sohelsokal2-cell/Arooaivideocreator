# ============================================================
# Gemini AI Voice Over Agent Settings (Multi-API Failover Pool)
# ============================================================

# Gemini API Keys (https://aistudio.google.com/app/apikey থেকে ফ্রি পাওয়া যায়)
# অতিরিক্ত কী যোগ করলে একটিতে কোটা/রেট-লিমিট (429) বা এরর আসলে স্বয়ংক্রিয়ভাবে পরের কী-তে সুইচ করবে।
# মোট ১০টি API Key অপশন (স্ক্রিপ্ট যাতে কখনই আটকে না গিয়ে নিরবচ্ছিন্নভাবে তৈরি হয়):
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=

# ডিফল্ট ভয়েস: Charon (পুরুষ), Kore (নারী), Aoede (সংবাদ উপস্থাপিকা নারী)
DEFAULT_VOICE=Charon

# সংবাদের দৃশ্যগুলোর মাঝের বিরতি (সেকেন্ডে):
PAUSE_SECONDS=0.5

# এমার্জেন্সি ব্যাকআপ (যদি সব Gemini API Key সাময়িক শেষ হয়ে যায়):
FALLBACK_TO_EDGE_TTS=false
