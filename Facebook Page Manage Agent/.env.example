# ============================================================
# Facebook Page Manage Agent Configuration
# ============================================================

# Facebook Graph API Credentials
# (https://developers.facebook.com/tools/explorer থেকে পেজ টোকেন ও আইডি পাওয়া যায়)
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# গ্রোক এআই ব্রেন (Viral Growth & Engagement Strategist)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# অটো-পাবলিশিং মোড: DIRECT / SCHEDULE / DRAFT
PUBLISH_MODE=DIRECT

# প্রি-পাবলিশিং কমেন্ট (First Comment): true দিলে পিন কমেন্ট নিজে থেকেই ড্রপ করবে
AUTO_PIN_FIRST_COMMENT=true

