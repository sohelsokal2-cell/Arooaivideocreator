# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Free Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Colab LivePortrait API endpoint (Provided when you run colab notebook)
# Example: https://abc-123.trycloudflare.com or Ngrok URL
COLAB_API_URL=

# Port for Render healthcheck (Default 8000)
PORT=8000

