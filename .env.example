# News Collector Agent Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Writer Agent Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Voice Over Agent Configuration
GEMINI_API_KEY_1=your_gemini_key_1
GEMINI_API_KEY_2=your_gemini_key_2
DEFAULT_VOICE=Kore
FALLBACK_TO_EDGE_TTS=true
PAUSE_SECONDS=0.8
VOICE_SPEED=0.92

# Facebook Page Manage Agent Configuration
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FB_GROQ_API_KEY=your_fb_groq_key
PUBLISH_MODE=DIRECT
AUTO_PIN_FIRST_COMMENT=true

# YouTube Page Manage Agent Configuration
YT_CLIENT_ID=your_google_client_id
YT_CLIENT_SECRET=your_google_client_secret
YT_REFRESH_TOKEN=your_youtube_refresh_token
YT_GROQ_API_KEY=your_yt_groq_key
YT_PUBLISH_MODE=PUBLIC
YT_AUTO_ADD_SHORTS_TAG=true
YT_AUTO_PIN_COMMENT=true

# Voice Assistant Agent Configuration
VA_GROQ_API_KEY=your_assistant_groq_key
VA_TTS_VOICE=bn-BD-NabanitaNeural
